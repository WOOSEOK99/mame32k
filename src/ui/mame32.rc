IDR_MAIN_MENU MENU DISCARDABLE 
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "종료(&X)",                    ID_FILE_EXIT
    END
    POPUP "정보(&H)"
    BEGIN
        MENUITEM "MAME32에 대하여(&A)",         ID_ABOUT
    END
END

IDR_UI_MENU MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "실행(&P)",                    ID_FILE_PLAY
//#ifdef MAME_AVI (NEW_AVI)
        MENUITEM "AVI녹화 모드로 실행",   		ID_FILE_PLAY_WITH_AVI
//#endif        
        MENUITEM SEPARATOR
        MENUITEM "게임 실행후 리플레이 기록(&R)...", ID_FILE_PLAY_RECORD
        MENUITEM "리플레이 실행(&L)...",        ID_FILE_PLAY_BACK
        MENUITEM "저장된 kaillera 입력실행(&K)...", 
                                                ID_FILE_KAILLERA_PLAY_BACK
//#ifdef MAME_AVI                                                
        MENUITEM "리플레이 내용으로 AVI녹화",   ID_FILE_PLAY_BACK_AVI
//#endif		
        MENUITEM "네트워크 게임(&N)...",        ID_FILE_NETPLAY
        MENUITEM SEPARATOR
        MENUITEM "Savestate 로드(&D)...",       ID_FILE_LOADSTATE
        MENUITEM SEPARATOR
        MENUITEM "임의 게임 선택(&S)",          ID_CONTEXT_SELECT_RANDOM
        MENUITEM SEPARATOR
        MENUITEM "등록 정보(&O)",               ID_GAME_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "전체 게임 검사(&A)",          ID_FILE_AUDIT
        MENUITEM SEPARATOR
        MENUITEM "종료(&X)",                    ID_FILE_EXIT
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "도구모음(&T)\tAlt+T",         ID_VIEW_TOOLBARS
        MENUITEM "상태표시 바(&S)\tAlt+S",      ID_VIEW_STATUS
        MENUITEM "폴더 목록(&E)\tAlt+D",        ID_VIEW_FOLDERS
        MENUITEM "그림 영역(&P)\tAlt+P",        ID_VIEW_PICTURE_AREA
        MENUITEM "스크린 샷 탭(&B)\tAlt+B",     ID_VIEW_PAGETAB
        MENUITEM SEPARATOR
        MENUITEM "전체 화면(&F)\tF11",          ID_VIEW_FULLSCREEN
        MENUITEM SEPARATOR
        POPUP "그림 보기(&H)"
        BEGIN
            MENUITEM "스냅샷(&S)",                  ID_TOGGLE_TAB_SCREENSHOT
            MENUITEM "광고 전단(&F)",               ID_TOGGLE_TAB_FLYER
            MENUITEM "게임기(&C)",                  ID_TOGGLE_TAB_CABINET
            MENUITEM "표지(&M)",                    ID_TOGGLE_TAB_MARQUEE
            MENUITEM "타이틀(&T)",                  ID_TOGGLE_TAB_TITLE
            MENUITEM "제어판(&P)",                  ID_TOGGLE_TAB_CONTROL_PANEL

            MENUITEM "히스토리(&H)",                ID_TOGGLE_TAB_HISTORY
        END
        MENUITEM SEPARATOR
        MENUITEM "큰 아이콘(&A)",               ID_VIEW_LARGE_ICON
        MENUITEM "작은 아이콘(&M)",             ID_VIEW_SMALL_ICON
        MENUITEM "목록(&L)",                    ID_VIEW_LIST_MENU
        MENUITEM "자세히(&D)",                  ID_VIEW_DETAIL
        MENUITEM "그룹(&G)",                    ID_VIEW_GROUPED
        MENUITEM SEPARATOR
        POPUP "아이콘 정렬(&I)"
        BEGIN
            MENUITEM "게임 이름(&N)",               ID_VIEW_BYGAME
            MENUITEM "파일 이름(&I)",               ID_VIEW_BYDIRECTORY
            MENUITEM "제작사(&M)",                  ID_VIEW_BYMANUFACTURER
            MENUITEM "실행된 횟수(&P)",             ID_VIEW_BYTIMESPLAYED
            MENUITEM "게임 종류(&T)",               ID_VIEW_BYTYPE
            MENUITEM "제작 년도(&D)",               ID_VIEW_BYYEAR
        END
        MENUITEM "아이콘 줄맞춤(&U)",           ID_VIEW_LINEUPICONS
        MENUITEM SEPARATOR
        MENUITEM "새로 고침(&R)\tF5",           ID_UPDATE_GAMELIST
        MENUITEM "사용자 정의 필터(&C)\tCtrl+F", ID_CONTEXT_FILTERS
        MENUITEM "사용자 정의 필드(&Z)...",     ID_CUSTOMIZE_FIELDS
    END
    POPUP "옵션(&O)"
    BEGIN
        MENUITEM "게임 목록 글꼴(&F)...",       ID_OPTIONS_FONT
        MENUITEM "게임 목록 클론 색상(&C)...",  ID_OPTIONS_CLONE_COLOR
        MENUITEM "디렉토리 설정(&D)...",        ID_OPTIONS_DIR
        MENUITEM "기본 게임 설정(&O)...",       ID_OPTIONS_DEFAULTS
        MENUITEM "설정 초기화(&R)...",          ID_OPTIONS_RESET_DEFAULTS
        MENUITEM "인터페이스 옵션(&I)...",      ID_OPTIONS_INTERFACE
        MENUITEM "배경 이미지(&B)...",          ID_OPTIONS_BG
        MENUITEM "언어(&L)...",                 ID_OPTIONS_LANGUAGE
        MENUITEM SEPARATOR
        MENUITEM "Kaillera 채팅 글꼴(&K)...",   ID_OPTIONS_FONT_K
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "목차(&C)\tF1",                ID_HELP_CONTENTS
        MENUITEM "문제 해결(&T)",               ID_HELP_TROUBLE
        MENUITEM SEPARATOR
        MENUITEM "추가 또는 변경/삭제된 게임(&N)", ID_HELP_WHATS_NEW32
        MENUITEM "MAME 배포 일지(&M)",          ID_HELP_WHATS_NEW
        MENUITEM SEPARATOR
        MENUITEM "대하여(&A)",                  ID_HELP_ABOUT
    END
END

